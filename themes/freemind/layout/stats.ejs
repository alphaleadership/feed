<div class="tw-py-6">
  
  <!-- En-tête de la page -->
  <div class="tw-flex tw-items-center tw-gap-4 tw-border-b tw-border-slate-800 tw-pb-6 tw-mb-6">
    <div class="tw-bg-sky-500/10 tw-text-sky-400 tw-p-3 tw-rounded-xl">
      <i class="fa fa-line-chart tw-text-2xl"></i>
    </div>
    <div>
      <h1 class="tw-text-2xl tw-font-bold tw-text-slate-100 tw-m-0">Statistiques Globales</h1>
      <p class="tw-text-slate-400 tw-m-0 tw-mt-1">Analyse et exploration profonde des données de compromission indexées.</p>
    </div>
  </div>

  <!-- Chiffres Clés (KPI) -->
  <div class="row mb-4" id="kpi-container">
    <!-- Sera rempli par JS -->
  </div>

  <div class="row">
    <!-- Graphique d'évolution temporelle -->
    <div class="col-12 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-line-chart tw-text-sky-400 tw-mr-2"></i>Évolution temporelle cumulative</h3>
        </div>
        <div class="tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="evolution-chart"></div>
        </div>
      </div>
    </div>
    
    <!-- Répartition par Sévérité et Vérification -->
    <div class="col-md-6 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl tw-h-full">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-shield tw-text-sky-400 tw-mr-2"></i>Niveaux de Sévérité</h3>
        </div>
        <div class="tw-flex tw-justify-center tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="severity-chart"></div>
        </div>
      </div>
    </div>

    <div class="col-md-6 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl tw-h-full">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-check-circle tw-text-sky-400 tw-mr-2"></i>Statut de Vérification</h3>
        </div>
        <div class="tw-flex tw-justify-center tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="verification-chart"></div>
        </div>
      </div>
    </div>

    <!-- Top DataClasses -->
    <div class="col-md-12 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-database tw-text-sky-400 tw-mr-2"></i>Top 15 Types de données fuités (DataClasses)</h3>
        </div>
        <div class="tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="dataclass-chart"></div>
        </div>
      </div>
    </div>

    <!-- Fuites par année -->
    <div class="col-md-6 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl tw-h-full">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-calendar tw-text-sky-400 tw-mr-2"></i>Nombre de fuites par année</h3>
        </div>
        <div class="tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="year-count-chart"></div>
        </div>
      </div>
    </div>

    <!-- Top Companies -->
    <div class="col-md-6 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl tw-h-full">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-building tw-text-sky-400 tw-mr-2"></i>Top 10 Organisations les plus touchées</h3>
        </div>
        <div class="tw-bg-slate-950 tw-p-4 tw-rounded-xl">
          <div id="company-chart"></div>
        </div>
      </div>
    </div>

    <!-- Statistiques IA -->
    <div class="col-md-12 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-violet-500/30 tw-rounded-2xl tw-p-6 tw-shadow-2xl">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-robot tw-text-violet-400 tw-mr-2"></i>Statistiques des Brèches liées à l'IA</h3>
        </div>
        <div>
          <div class="row" id="ia-stats-container">
            <div class="col-12 text-center py-5">
              <i class="fa fa-spinner fa-spin tw-text-violet-400 tw-text-2xl tw-mb-2"></i>
              <p class="tw-text-slate-400 tw-m-0">Chargement...</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Statistiques Sites Fermés -->
    <div class="col-md-12 mb-4">
      <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl">
        <div class="tw-border-b tw-border-slate-800 tw-pb-4 tw-mb-4">
          <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-m-0"><i class="fa fa-ban tw-text-rose-400 tw-mr-2"></i>Statistiques des Sites Fermés</h3>
        </div>
        <div>
          <div class="row" id="closed-sites-stats-container">
            <div class="col-12 text-center py-5">
              <i class="fa fa-spinner fa-spin tw-text-rose-400 tw-text-2xl tw-mb-2"></i>
              <p class="tw-text-slate-400 tw-m-0">Chargement...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="stats-tooltip" style="position: absolute; visibility: hidden; background: rgba(15, 23, 42, 0.95); color: #f8fafc; padding: 10px; border: 1px solid #334155; border-radius: 8px; pointer-events: none; font-family: system-ui, -apple-system, sans-serif; font-size: 0.9em; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.5);"></div>

<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="<%- config.root %>js/stats-page.js"></script>

<style>
  text { font-family: system-ui, -apple-system, sans-serif; font-size: 10px; fill: #94a3b8; }
  .axis path, .axis line { stroke: #334155; }
</style>
