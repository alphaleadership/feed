<%
  // Charger les données de breaches
  var breaches = site.data.breaches ? site.data.breaches.breaches : [];
  
  // Créer un objet pour regrouper par DataClass
  var dataClassGroups = {};
  
  breaches.filter(breach => !breach.IsRetired).forEach(function(breach) {
    if (breach.DataClasses && Array.isArray(breach.DataClasses)) {
      breach.DataClasses.forEach(function(dataClass) {
        if (!dataClassGroups[dataClass]) {
          dataClassGroups[dataClass] = {
            name: dataClass,
            breaches: [],
            totalPwnCount: 0
          };
        }
        dataClassGroups[dataClass].breaches.push(breach);
        dataClassGroups[dataClass].totalPwnCount += (breach.PwnCount || 0);
      });
    }
  });
  
  // Convertir en tableau et trier par nombre de fuites
  var sortedDataClasses = Object.values(dataClassGroups).sort((a, b) => b.breaches.length - a.breaches.length);
%>

<div class="dataclasses-wrapper tw-py-6">
  <div class="tw-bg-slate-900 tw-border tw-border-slate-800 tw-rounded-2xl tw-p-6 tw-shadow-2xl">
    
    <!-- En-tête de la page -->
    <div class="tw-flex tw-items-center tw-gap-4 tw-border-b tw-border-slate-800 tw-pb-6 tw-mb-6">
      <div class="tw-bg-sky-500/10 tw-text-sky-400 tw-p-3 tw-rounded-xl">
        <i class="fa fa-database tw-text-2xl"></i>
      </div>
      <div>
        <h1 class="tw-text-2xl tw-font-bold tw-text-slate-100 tw-m-0">
          <%= sortedDataClasses.length %> Types de Données Fuitées
        </h1>
        <p class="tw-text-slate-400 tw-m-0 tw-mt-1">
          Classification et répartition des fuites par catégories de données compromises.
        </p>
      </div>
    </div>

    <!-- Filtre de recherche -->
    <div class="tw-mb-6 tw-relative">
      <span class="tw-absolute tw-left-4 tw-top-1/2 tw-translate-y-[-50%] tw-text-slate-500">
        <i class="fa fa-search"></i>
      </span>
      <input type="text" id="category-search" placeholder="Rechercher un type de données (ex: Mots de passe, Identité...)..." 
             class="tw-w-full tw-bg-slate-950 tw-border tw-border-slate-800 tw-text-slate-200 tw-rounded-xl tw-py-3 tw-pl-11 tw-pr-4 focus:tw-outline-none focus:tw-border-sky-500 focus:tw-ring-1 focus:tw-ring-sky-500 tw-transition-all">
    </div>
    
    <!-- Grille de catégories -->
    <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 lg:tw-grid-cols-3 tw-gap-6">
      <% sortedDataClasses.forEach(function(dataClass, index) { 
        var percentage = ((dataClass.breaches.length / breaches.length) * 100).toFixed(1);
        var accentClass = index < 3 ? 'tw-border-red-500/30 hover:tw-border-red-500' : index < 10 ? 'tw-border-amber-500/30 hover:tw-border-amber-500' : 'tw-border-sky-500/30 hover:tw-border-sky-500';
        var badgeColor = index < 3 ? 'tw-bg-red-500/10 tw-text-red-400' : index < 10 ? 'tw-bg-amber-500/10 tw-text-amber-400' : 'tw-bg-sky-500/10 tw-text-sky-400';
      %>
        <div class="dataclass-col" data-name="<%= dataClass.name %>">
          <div class="tw-bg-slate-950 tw-border tw-rounded-xl tw-p-5 tw-flex tw-flex-col tw-h-full tw-transition-all tw-duration-300 hover:tw-translate-y-[-4px] hover:tw-shadow-[0_4px_20px_rgba(0,0,0,0.4)] <%= accentClass %>">
            
            <div class="tw-flex tw-justify-between tw-items-center tw-mb-4">
              <span class="tw-px-3 tw-py-1 tw-rounded-lg tw-text-sm tw-font-semibold <%= badgeColor %>">
                #<%= index + 1 %>
              </span>
              <span class="tw-text-xs tw-text-slate-500 tw-font-medium"><%= percentage %> %</span>
            </div>
            
            <h3 class="tw-text-lg tw-font-semibold tw-text-slate-200 tw-mb-4 tw-flex tw-items-center tw-gap-2">
              <i class="fa fa-shield tw-text-sky-400 tw-text-sm"></i>
              <%= dataClass.name %>
            </h3>
            
            <div class="tw-mb-4 tw-space-y-2">
              <div class="tw-flex tw-items-center tw-justify-between tw-text-sm">
                <span class="tw-text-slate-400"><i class="fa fa-exclamation-triangle tw-mr-2 tw-text-amber-500"></i>Incidents</span>
                <span class="tw-text-slate-200 tw-font-semibold"><%= dataClass.breaches.length.toLocaleString() %> fuites</span>
              </div>
              <div class="tw-flex tw-items-center tw-justify-between tw-text-sm">
                <span class="tw-text-slate-400"><i class="fa fa-users tw-mr-2 tw-text-sky-500"></i>Comptes impactés</span>
                <span class="tw-text-slate-200 tw-font-semibold">
                  ~<%= dataClass.totalPwnCount >= 1000000000 ? (dataClass.totalPwnCount / 1000000000).toFixed(2) + ' Md' : (dataClass.totalPwnCount / 1000000).toFixed(1) + ' M' %>
                </span>
              </div>
            </div>
            
            <details class="breach-details-list tw-mt-auto">
              <summary class="tw-text-sm tw-text-sky-400 hover:tw-text-sky-300 tw-cursor-pointer tw-font-medium tw-list-none">
                <i class="fa fa-chevron-right tw-text-xs tw-mr-1"></i> Voir les fuites majeures
              </summary>
              <ul class="tw-list-none tw-p-0 tw-m-0 tw-mt-3 tw-space-y-2 tw-max-h-60 tw-overflow-y-auto tw-pr-1">
                <% dataClass.breaches.sort((a, b) => (b.PwnCount || 0) - (a.PwnCount || 0)).slice(0, 10).forEach(function(breach) { 
                  var severityColors = {
                    'CRITIQUE': 'tw-bg-red-500/10 tw-text-red-400 tw-border-red-500/20',
                    'ÉLEVÉ': 'tw-bg-amber-500/10 tw-text-amber-400 tw-border-amber-500/20',
                    'MODÉRÉ': 'tw-bg-sky-500/10 tw-text-sky-400 tw-border-sky-500/20',
                    'FAIBLE': 'tw-bg-slate-500/10 tw-text-slate-400 tw-border-slate-500/20'
                  };
                %>
                  <li class="tw-border-b tw-border-slate-900 tw-pb-2">
                    <a href="<%- url_for('/fuites?id=' + breach.index) %>" class="tw-flex tw-justify-between tw-items-start tw-text-sm tw-text-slate-400 hover:tw-text-sky-300 tw-no-underline">
                      <span class="tw-truncate tw-mr-2">
                        <%= breach.Title || breach.Name %>
                        <% if (breach.SeverityLevel) { %>
                          <span class="tw-text-[10px] tw-px-1.5 tw-py-0.5 tw-rounded tw-border tw-ml-1 <%= severityColors[breach.SeverityLevel] %>">
                            <%= breach.SeverityLevel %>
                          </span>
                        <% } %>
                      </span>
                      <span class="tw-text-xs tw-text-slate-500 tw-shrink-0">
                        <%= breach.PwnCount ? (breach.PwnCount >= 1000000 ? (breach.PwnCount / 1000000).toFixed(1) + 'M' : breach.PwnCount.toLocaleString()) : 'N/A' %>
                      </span>
                    </a>
                  </li>
                <% }); %>
              </ul>
            </details>

          </div>
        </div>
      <% }); %>
    </div>

  </div>
</div>

<script>
  document.getElementById('category-search').addEventListener('input', function(e) {
    const searchVal = e.target.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    const cards = document.querySelectorAll('.dataclass-col');
    cards.forEach(card => {
      const title = card.getAttribute('data-name').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      if (title.includes(searchVal)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>

<style>
  .breach-details-list summary::-webkit-details-marker {
    display: none;
  }
  
  .breach-details-list ul {
    scrollbar-width: thin;
    scrollbar-color: #38bdf8 #0f172a;
  }
  
  .breach-details-list ul::-webkit-scrollbar {
    width: 4px;
  }
  
  .breach-details-list ul::-webkit-scrollbar-track {
    background: #0f172a;
  }
  
  .breach-details-list ul::-webkit-scrollbar-thumb {
    background: #38bdf8;
    border-radius: 2px;
  }
</style>
