<div id="threat-actors-container" class="tw-py-6">
  
  <!-- En-tête de la page -->
  <div class="tw-flex tw-items-center tw-gap-4 tw-border-b tw-border-slate-800 tw-pb-6 tw-mb-6">
    <div class="tw-bg-sky-500/10 tw-text-sky-400 tw-p-3 tw-rounded-xl">
      <i class="fa fa-user-secret tw-text-2xl"></i>
    </div>
    <div>
      <h1 class="tw-text-2xl tw-font-bold tw-text-slate-100 tw-m-0">Pirates et Groupes de Hackers</h1>
      <p class="tw-text-slate-400 tw-m-0 tw-mt-1">Exploration des fuites de données par auteur de l'attaque.</p>
    </div>
  </div>

  <!-- Filtre de recherche -->
  <div class="tw-mb-6 tw-relative">
    <span class="tw-absolute tw-left-4 tw-top-1/2 tw-translate-y-[-50%] tw-text-slate-500">
      <i class="fa fa-search"></i>
    </span>
    <input type="text" id="actor-search" placeholder="Rechercher un pirate, un groupe, un incident ou un statut..." 
           class="tw-w-full tw-bg-slate-950 tw-border tw-border-slate-800 tw-text-slate-200 tw-rounded-xl tw-py-3 tw-pl-11 tw-pr-4 focus:tw-outline-none focus:tw-border-sky-500 focus:tw-ring-1 focus:tw-ring-sky-500 tw-transition-all">
  </div>

  <div id="actors-list">
    <div class="tw-text-center tw-py-12 tw-text-slate-400">
      <i class="fa fa-spinner fa-spin tw-text-2xl tw-mb-3"></i>
      <p class="tw-m-0">Chargement des données...</p>
    </div>
  </div>
</div>

<script src="<%- config.root %>js/threat-actors-page.js"></script>
