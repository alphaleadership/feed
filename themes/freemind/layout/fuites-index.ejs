<style>
  :root {
    --bg-main: #0c1022;
    --bg-card: #161c36;
    --border-color: #2a3358;
    --text-primary: #eef2ff;
    --text-secondary: #b6c2dd;
    --accent: #a3e635;
    --accent-hover: #bef264;
    --danger-bg: #450a0a;
    --danger-border: #991b1b;
    --danger-text: #fecaca;
  }

  #fuites-container {
    padding: 2em 0;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text-primary);
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .fuites-header {
    margin-bottom: 2em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1em;
  }

  .fuites-header h1 {
    font-size: 2em;
    font-weight: 600;
    margin: 0 0 0.5em 0;
  }

  .fuite-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5em;
  }

  .fuite-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5em;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .fuite-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    border-color: var(--accent);
  }

  .fuite-card a.title-link {
    font-size: 1.25em;
    font-weight: 600;
    text-decoration: none;
    color: var(--accent);
    margin-bottom: 0.5em;
    display: block;
    word-break: break-word;
  }

  .fuite-card a.title-link:hover {
    color: var(--accent-hover);
  }

  .fuite-card .date {
    color: var(--text-secondary);
    font-size: 0.9em;
    margin-bottom: 1em;
  }

  .data-classes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: auto;
  }

  .data-class {
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    padding: 0.2em 0.6em;
    border-radius: 12px;
    font-size: 0.8em;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .severity-badge {
    display: inline-block;
    padding: 0.3em 0.8em;
    border-radius: 12px;
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5em;
  }

  .severity-critique {
    background-color: rgba(220, 38, 38, 0.2);
    color: #fca5a5;
    border: 1px solid rgba(220, 38, 38, 0.4);
  }

  .severity-eleve {
    background-color: rgba(251, 191, 36, 0.2);
    color: #fcd34d;
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .severity-modere {
    background-color: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .severity-faible {
    background-color: rgba(107, 114, 128, 0.2);
    color: #d1d5db;
    border: 1px solid rgba(107, 114, 128, 0.4);
  }

  .ia-badge {
    display: inline-block;
    padding: 0.3em 0.8em;
    border-radius: 12px;
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: rgba(139, 92, 246, 0.2);
    color: #c4b5fd;
    border: 1px solid rgba(139, 92, 246, 0.4);
    margin-left: 0.5em;
  }

  .tag-badge {
    display: inline-block;
    padding: 0.3em 0.8em;
    border-radius: 12px;
    font-size: 0.75em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 0.5em;
    margin-bottom: 0.5em;
  }
  .tag-ia {
    background-color: rgba(139, 92, 246, 0.2);
    color: #c4b5fd;
    border: 1px solid rgba(139, 92, 246, 0.4);
  }
  .tag-santé {
    background-color: rgba(16, 185, 129, 0.2);
    color: #a7f3d0;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }
  .tag-gouvernement {
    background-color: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }
  .tag-éducation {
    background-color: rgba(59, 130, 246, 0.2);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }
  .tag-finance {
    background-color: rgba(245, 158, 11, 0.2);
    color: #fde68a;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }
  .tag-télécom {
    background-color: rgba(6, 182, 212, 0.2);
    color: #a5f3fc;
    border: 1px solid rgba(6, 182, 212, 0.4);
  }

  .nsfw-warning {
    background-color: var(--danger-bg);
    border: 1px solid var(--danger-border);
    padding: 15px;
    border-radius: 6px;
    margin-bottom: 15px;
  }

  .nsfw-warning h2, .nsfw-warning h3 {
    margin: 0 0 10px 0;
    color: var(--danger-text);
    font-size: 1.1em;
  }

  .nsfw-warning p {
    color: var(--danger-text);
    font-size: 0.9em;
    margin-bottom: 10px;
    opacity: 0.9;
  }

  .show-nsfw-link {
    background-color: var(--danger-border);
    color: #eef2ff;
    border: none;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9em;
    font-weight: 500;
    transition: background-color 0.2s;
  }

  .show-nsfw-link:hover {
    background-color: #b91c1c;
  }

  .hidden {
    display: none !important;
  }

  /* Details View */
  .breach-details {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2em;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .breach-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5em;
    margin-bottom: 1.5em;
  }

  .breach-header h1 {
    font-size: 2.5em;
    margin: 0;
    color: var(--text-primary);
  }

  .breach-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5em;
    margin-top: 1.5em;
    background: var(--bg-main);
    padding: 1.5em;
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-weight: 600;
    font-size: 0.85em;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5em;
  }

  .meta-value {
    font-size: 1.1em;
    color: var(--text-primary);
  }

  .meta-value a {
    color: var(--accent);
    text-decoration: none;
  }

  .meta-value a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .breach-content {
    margin-top: 2em;
  }

  .breach-content h2 {
    font-size: 1.5em;
    color: var(--text-primary);
    margin-top: 1.5em;
    margin-bottom: 1em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5em;
  }

  .breach-content .description {
    line-height: 1.7;
    color: var(--text-secondary);
    font-size: 1.05em;
  }

  .nav-buttons {
    display: flex;
    justify-content: space-between;
    margin-top: 2em;
    padding-top: 2em;
    border-top: 1px solid var(--border-color);
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7em 1.2em;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
    font-weight: 500;
  }

  .nav-btn:hover {
    background-color: var(--border-color);
    color: #eef2ff;
  }
  
  .nav-btn.primary {
    background-color: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    border-color: rgba(56, 189, 248, 0.2);
  }
  
  .nav-btn.primary:hover {
    background-color: var(--accent);
    color: #0c1022;
  }
</style>


<div id="fuites-container">
  <h1>Chargement des données...</h1>
</div>

<script src="<%- config.root %>js/fuites-page.js"></script>
