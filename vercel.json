          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
