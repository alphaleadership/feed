{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hexo",
  "buildCommand": "npx hexo generate --cache",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(json|xml|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000, stale-if-error=2592000"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/fancybox/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|eot|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
