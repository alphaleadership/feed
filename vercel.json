{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hexo",
  "buildCommand": "node --max-old-space-size=4096 ./node_modules/hexo/bin/hexo generate",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://d3js.org https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://cloud.umami.is https://giscus.app https://html5shiv.googlecode.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cloud.umami.is https://giscus.app https://bff.ecoindex.fr; frame-src https://giscus.app; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), bluetooth=(), payment=(), display-capture=(), screen-wake-lock=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800, stale-if-error=2592000"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(json|xml|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=400, s-maxage=500, stale-while-revalidate=400, stale-if-error=4000"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/fancybox/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|eot|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
