        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=31536000"
